# Non-secret, per-environment settings for deploy/k8s/imaging.yaml
NAMESPACE=oncontrol
REPLICAS=1
CPU_REQUEST=250m
CPU_LIMIT=1500m
MEMORY_REQUEST=1Gi
MEMORY_LIMIT=2560Mi
STORAGE_SIZE=4Gi
# Same-origin paths: the browser resolves them against the public host, and the
# gateway/Ingress routes /imaging -> imaging (prefix stripped) and /volview -> Orthanc.
PUBLIC_BASE_URL=/imaging
VOLVIEW_URL=/volview/index.html
CORS_ALLOWED_ORIGINS=*
