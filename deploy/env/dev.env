# Non-secret, per-environment settings for deploy/k8s/imaging.yaml
NAMESPACE=oncontrol
REPLICAS=1
CPU_REQUEST=250m
CPU_LIMIT=1500m
MEMORY_REQUEST=1Gi
MEMORY_LIMIT=2560Mi
STORAGE_SIZE=4Gi
# In-cluster defaults; set the public URLs once the platform is exposed (ingress).
PUBLIC_BASE_URL=http://imaging.oncontrol.svc.cluster.local:8001
VOLVIEW_URL=http://orthanc.oncontrol.svc.cluster.local:8042/volview/index.html
CORS_ALLOWED_ORIGINS=*
