# Non-secret, per-environment settings for deploy/k8s/imaging.yaml
NAMESPACE=oncontrol
# HPA bounds: max stays 1 while storage is an emptyDir (see imaging.yaml).
MIN_REPLICAS=1
MAX_REPLICAS=1
CPU_REQUEST=250m
CPU_LIMIT=1500m
MEMORY_REQUEST=1Gi
MEMORY_LIMIT=2560Mi
STORAGE_SIZE=4Gi
# Same-origin paths: the browser resolves them against the public host, and the
# gateway/Ingress routes /imaging -> imaging (prefix stripped) and /volview -> Orthanc.
PUBLIC_BASE_URL=/imaging
VOLVIEW_URL=/volview/index.html
# The CORS origin comes from the `edge` ConfigMap (PUBLIC_ORIGIN), see imaging.yaml.
