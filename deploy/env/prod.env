# Non-secret, per-environment settings for deploy/k8s/imaging.yaml
NAMESPACE=oncontrol
REPLICAS=1
CPU_REQUEST=500m
CPU_LIMIT=1500m
MEMORY_REQUEST=1536Mi
MEMORY_LIMIT=2560Mi
STORAGE_SIZE=8Gi
PUBLIC_BASE_URL=http://imaging.oncontrol.svc.cluster.local:8001
VOLVIEW_URL=http://orthanc.oncontrol.svc.cluster.local:8042/volview/index.html
# Restrict to the VolView/Orthanc origin once exposed.
CORS_ALLOWED_ORIGINS=*
