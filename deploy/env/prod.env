# Non-secret, per-environment settings for deploy/k8s/imaging.yaml
NAMESPACE=oncontrol-prod
# HPA bounds: max stays 1 while storage is an emptyDir (see imaging.yaml).
MIN_REPLICAS=1
MAX_REPLICAS=1
CPU_REQUEST=500m
CPU_LIMIT=1500m
MEMORY_REQUEST=1536Mi
MEMORY_LIMIT=2560Mi
STORAGE_SIZE=8Gi
PUBLIC_BASE_URL=/imaging
VOLVIEW_URL=/volview/index.html
# The CORS origin comes from the `edge` ConfigMap (PUBLIC_ORIGIN), see imaging.yaml.
