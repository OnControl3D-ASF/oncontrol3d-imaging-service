# OnControl Imaging Service — environment template.
# Copy to `.env` for local dev, or set these as env vars on Render/Azure.

# Where Orthanc (PACS) is reachable FROM THIS SERVICE.
# Local: http://localhost:8042 . Deployed: internal URL or public HTTPS of Orthanc.
ORTHANC_URL=http://localhost:8042

# Orthanc credentials (only if AuthenticationEnabled=true in orthanc.json).
# ORTHANC_USERNAME=
# ORTHANC_PASSWORD=

# Public base URL of THIS microservice, used to build the lung-volume download
# link that VolView fetches. Must be reachable from the doctor's BROWSER over
# HTTPS. No trailing slash. Examples:
#   https://oncontrol-imaging.onrender.com
#   https://<tunnel>.trycloudflare.com
PUBLIC_BASE_URL=http://localhost:8001

# Public URL of the VolView viewer (served by the Orthanc VolView plugin).
# Must be reachable from the browser over HTTPS.
VOLVIEW_URL=http://localhost:8042/volview/index.html

# Directory for raw/derived volumes (mount a persistent disk here in prod).
STORAGE_DIR=storage
